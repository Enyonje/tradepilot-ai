generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpportunityStatus {
  DISCOVERED
  RESEARCHING
  APPROVED
  REJECTED
  LISTED
  ARCHIVED
}

model ProductOpportunity {
  id                String            @id @default(cuid())
  title             String
  sourceUrl         String?
  imageUrl          String?
  sourceName        String?
  targetCountry     String            @default("US")
  currency          String            @default("USD")
  marketplace       String?
  supplierPrice     Decimal           @db.Decimal(12, 2)
  shippingCost      Decimal           @default(0) @db.Decimal(12, 2)
  platformFees      Decimal           @default(0) @db.Decimal(12, 2)
  paymentFees       Decimal           @default(0) @db.Decimal(12, 2)
  returnsReserve    Decimal           @default(0) @db.Decimal(12, 2)
  taxAndDutyReserve Decimal           @default(0) @db.Decimal(12, 2)
  estimatedSalePrice Decimal          @db.Decimal(12, 2)
  status            OpportunityStatus @default(DISCOVERED)
  evidence          Json?
  supplierId        String?
  supplier          Supplier?         @relation(fields: [supplierId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([targetCountry, status])
  @@index([createdAt])
}

model AgentRun {
  id          String   @id @default(cuid())
  agentKey    String
  status      String
  input       Json?
  output      Json?
  provider    String?
  error       String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
}

model AiUsage {
  id           String   @id @default(cuid())
  provider     String
  model        String
  task         String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int
  success      Boolean
  createdAt    DateTime @default(now())

  @@index([provider, createdAt])
}


model Supplier {
  id              String   @id @default(cuid())
  name            String
  website         String?
  countryCode     String
  contactEmail    String?
  sourceType      String   @default("manual")
  rating          Float?
  verified        Boolean  @default(false)
  shippingNotes   String?
  returnPolicy    String?
  products        ProductOpportunity[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([countryCode])
  @@index([verified])
}

model ProductSource {
  id          String   @id @default(cuid())
  name        String
  sourceType  String
  sourceUrl   String?
  countryCode String?
  enabled     Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled, sourceType])
}
