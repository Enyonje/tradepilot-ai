{
  "name": "tradepilot-ai",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @tradepilot/api\" \"npm run dev -w @tradepilot/web\"",
    "build": "npm run build -w @tradepilot/api && npm run build -w @tradepilot/web",
    "db:generate": "npm run db:generate -w @tradepilot/api",
    "db:migrate": "npm run db:migrate -w @tradepilot/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}