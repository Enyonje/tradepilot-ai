# API
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://tradepilot:tradepilot@localhost:5432/tradepilot?schema=public
REDIS_URL=redis://localhost:6379

# AI providers — configure at least one
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Provider order: openai,gemini,groq
AI_PROVIDER_ORDER=openai,gemini,groq
AI_REQUEST_TIMEOUT_MS=25000

# Frontend
VITE_API_URL=http://localhost:4000/api

# Commerce research connectors (all optional; configure only providers you use)
CJ_API_KEY=
SERPAPI_API_KEY=
# Trawl provides third-party eBay sold-item research; it is not an official eBay API.
TRAWL_API_KEY=
TRAWL_API_BASE=https://api.trawl.dev
COMMERCE_CONNECTOR_TIMEOUT_MS=15000
